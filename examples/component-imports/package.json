{
  "name": "fastedge-example-component-imports",
  "version": "1.0.0",
  "description": "FastEdge JS example: import a Wasm component (Rust image thumbnails) by its WIT interface",
  "type": "module",
  "scripts": {
    "build": "npm run create-images-manifest && fastedge-build -c",
