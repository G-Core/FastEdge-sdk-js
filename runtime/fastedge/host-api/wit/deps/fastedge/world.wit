package gcore:fastedge;

world reactor {
    import dictionary;
    import secret;
    import key-value;
    import utils;
    import cache-sync;
    import gcore:db/sql-sync@0.1.0;
    import gcore:db/kv-sync@0.1.0;

}

/// `reactor` plus the asynchronous `gcore:db/sql` (needs `wasi:io`).
world reactor-async {
    include reactor;
    import gcore:db/sql@0.1.0;
}
